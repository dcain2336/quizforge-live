# Copy this file to ".env" and fill in the keys you want to enable.  # Instruction line 1: how to use this file.
# Every key is OPTIONAL: QuizForge Live runs its full loop on the offline heuristic engine with no keys at all.  # Instruction line 2: nothing is mandatory.
# --- Nightshift (PRIMARY Nemotron route: the DGX Spark rule requires Nemotron THROUGH Nightshift) ---  # Section: Nightshift.
# Nightshift is LOCAL-ONLY software (free Windows / Mac editions): there is no hosted console,  # Fact: no cloud Nightshift exists.
# no signup, and no cloud endpoint. Install it on the machine that runs QuizForge Live, open its  # Fact continued: the Console is a tab in the local app.
# Console tab to generate the runtime token (also written to <stateDir>/proxy-token), and set:  # How to get the token.
# The base URL of your local Nightshift install (the documented default).  # The documented local endpoint.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# The runtime token from your local Nightshift Console tab - never committed, never shared.  # The local credential.
METERLESS_RUNTIME_TOKEN=
# The model Nightshift routes to (documented default; the auto router logs the actual model).  # The documented model default.
METERLESS_MODEL=meterless/auto
# Pin an explicit Nemotron model instead of the auto router (used when METERLESS_MODEL is unset).  # The DGX-rule pin.
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl
# Legacy names from Stage 1/2 still work as fallbacks when the METERLESS_* names are unset.  # Backward compatibility note.
# NIGHTSHIFT_API_URL=
# NIGHTSHIFT_API_KEY=
# The Nightshift chat path, only needed if a Nightshift build documents a non-default route.  # Default: /chat/completions (confirmed OpenAI-compatible).
# NIGHTSHIFT_CHAT_PATH=/chat/completions
# SECURITY: the NVIDIA API key lives in Nightshift's Providers tab, NEVER in code or this repo.  # The security rule, exact workspace wording.
# --- OpenRouter (FALLBACK Nemotron route: verified ARC free-tier seat) ---  # Section: OpenRouter.
# Get a key at https://openrouter.ai - free tier.  # Where to get the OpenRouter key.
OPENROUTER_API_KEY=<redacted>
# The OpenRouter model slug for the fallback route.  # The fallback seat.
NEMOTRON_MODEL_FALLBACK=nvidia/nemotron-3.5-super-vl:free
# --- Groq (optional legacy route kept from v1): get a key at https://console.groq.com ---  # Section: Groq.
GROQ_API_KEY=<redacted>
# --- Zetaris AI Data Harness (Wildcard lane requirement: BOTH Zetaris and Meterless) ---  # Section: Zetaris.
# HONEST STATE (2026-10-23): the workspace's promised free participant instance is still a TBC  # Where the credentials come from: nowhere yet.
# placeholder - no URL or key has been issued to anyone. When an instance exists (yours or the  # The values below stay empty until one does.
# organizers'), point these at it; until then zetaris.py stays preflight-gated and the agent runs  # The offline fallback covers the demo meanwhile.
# on the local corpus fallback. The REST shape is verified against Zetaris's public scripts.  # Verified surface, unverified instance.
ZETARIS_REST_URL=
ZETARIS_API_KEY=
# The numeric Zetaris org id (their reference scripts default to 1).  # The X-Org-ID header value.
ZETARIS_ORG_ID=1
# The provisioned study-corpus table the agent queries on the instance (source_name, excerpt).  # The table loaded per the getting-started first-dataset guide.
ZETARIS_CORPUS_TABLE=quizforge.study_chunks
# --- Meterless metering mirror (OPTIONAL - the JSONL evidence under logs/ is the record) ---  # Section: metering.
# The Meterless ENGINES need no credentials at all: they are open source (Apache-2.0) and the  # The engine in markovian.py runs locally, keyless.
# Markovian engine runs locally in markovian.py. These two values only enable an OPTIONAL remote  # What these two values actually do.
# mirror of the metering events; leave them empty and nothing changes locally.  # Empty is the normal state.
METERLESS_API_URL=
METERLESS_API_KEY=
# Override for the JSONL evidence directory (default: ./logs next to app.py).  # The judges' evidence folder.
# METERLESS_LOG_DIR=./logs
